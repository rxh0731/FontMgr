{
  "版本": 3,
  "分组": {
    "L1 降噪": {
      "说明": "平滑/滤波，减少随机噪点",
      "算法": {
        "高斯滤波": {
          "说明": "高斯核平滑，适合均匀噪点",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                15,
                2
              ],
              "默认": 5
            }
          }
        },
        "中值滤波": {
          "说明": "中值滤波，专门对付椒盐噪点",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                9,
                2
              ],
              "默认": 3
            }
          }
        },
        "双边滤波": {
          "说明": "边缘保持平滑，减少纸张纹理",
          "参数": {
            "d": {
              "类型": "int",
              "范围": [
                3,
                21,
                2
              ],
              "默认": 9
            },
            "颜色σ": {
              "类型": "float",
              "范围": [
                10,
                200
              ],
              "默认": 75
            },
            "空间σ": {
              "类型": "float",
              "范围": [
                10,
                200
              ],
              "默认": 75
            }
          }
        },
        "NLM降噪": {
          "说明": "非局部均值降噪，对重噪效果好但较慢",
          "参数": {
            "h": {
              "类型": "float",
              "范围": [
                3,
                30
              ],
              "默认": 10
            },
            "模板窗": {
              "类型": "int",
              "范围": [
                3,
                7,
                2
              ],
              "默认": 7
            },
            "搜索窗": {
              "类型": "int",
              "范围": [
                7,
                21,
                2
              ],
              "默认": 21
            }
          }
        }
      }
    },
    "L2 背景分离": {
      "说明": "去除背景、补偿光照不均",
      "算法": {
        "背景差分": {
          "说明": "大核均值模糊作为背景估计→差分→放大→二值掩码扣背景",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                61,
                2
              ],
              "默认": 31
            },
            "阈值": {
              "类型": "int",
              "范围": [
                10,
                100
              ],
              "默认": 30
            },
            "放大倍率": {
              "类型": "float",
              "范围": [
                1,
                8
              ],
              "默认": 2
            },
            "归一化": {
              "类型": "bool",
              "默认": true
            }
          }
        },
        "形态学背景归一": {
          "说明": "大核开运算估计背景→原图除以背景（光照补偿）",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                101,
                2
              ],
              "默认": 51
            }
          }
        },
        "灰度黑帽增强": {
          "说明": "二值化前增强深色笔画与局部背景的差异，适合拓片和散点底纹",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                31,
                2
              ],
              "默认": 15
            },
            "强度": {
              "类型": "float",
              "范围": [
                0.1,
                2.0
              ],
              "默认": 1.0
            }
          }
        }
      }
    },
    "L3 二值化": {
      "说明": "核心二值化，灰度→黑白（必须选一个）",
      "算法": {
        "Otsu": {
          "说明": "全局大津阈值，适合直方图双峰的干净图片",
          "参数": {
            "偏移": {
              "类型": "int",
              "范围": [
                -50,
                50
              ],
              "默认": 0
            }
          }
        },
        "固定阈值": {
          "说明": "按指定灰度切分文字，适合背景噪声强但墨色范围稳定的拓片",
          "参数": {
            "阈值": {
              "类型": "int",
              "范围": [
                20,
                245
              ],
              "默认": 160
            }
          }
        },
        "Sauvola": {
          "说明": "局部自适应阈值 T=均值×(1+k×(std/R−1))，适合光照不均",
          "参数": {
            "窗口": {
              "类型": "int",
              "范围": [
                7,
                101,
                2
              ],
              "默认": 25
            },
            "k": {
              "类型": "float",
              "范围": [
                0.05,
                0.5
              ],
              "默认": 0.2
            },
            "R": {
              "类型": "int",
              "范围": [
                64,
                192
              ],
              "默认": 128
            }
          }
        },
        "percentile硬切": {
          "说明": "按灰度直方图百分位硬切，适合前景占比稳定的图片",
          "参数": {
            "暗色比例": {
              "类型": "float",
              "范围": [
                0.05,
                0.5
              ],
              "默认": 0.2
            }
          }
        },
        "Niblack": {
          "说明": "T=均值+k×标准差，对细笔画/枯笔保留更好",
          "参数": {
            "窗口": {
              "类型": "int",
              "范围": [
                7,
                101,
                2
              ],
              "默认": 25
            },
            "k": {
              "类型": "float",
              "范围": [
                -1.0,
                0.0
              ],
              "默认": -0.2
            }
          }
        },
        "Phansalkar": {
          "说明": "低光区指数补偿的局部阈值，极暗背景文字用",
          "参数": {
            "窗口": {
              "类型": "int",
              "范围": [
                7,
                101,
                2
              ],
              "默认": 25
            },
            "k": {
              "类型": "float",
              "范围": [
                0.05,
                0.5
              ],
              "默认": 0.25
            },
            "R": {
              "类型": "int",
              "范围": [
                64,
                192
              ],
              "默认": 128
            },
            "p": {
              "类型": "float",
              "范围": [
                1.0,
                5.0
              ],
              "默认": 2.0
            },
            "q": {
              "类型": "float",
              "范围": [
                5.0,
                20.0
              ],
              "默认": 10.0
            }
          }
        },
        "Wolf-Jolion": {
          "说明": "利用全局最大局部方差校正阈值，适合退化古籍和亮度不均",
          "参数": {
            "窗口": {
              "类型": "int",
              "范围": [
                7,
                101,
                2
              ],
              "默认": 31
            },
            "k": {
              "类型": "float",
              "范围": [
                0.05,
                0.8
              ],
              "默认": 0.35
            }
          }
        }
      }
    },
    "L4 形态清理": {
      "说明": "形态学操作清理二值掩码",
      "算法": {
        "黑帽扣除": {
          "说明": "形态学黑帽→检测暗色散点→从掩码扣除",
          "参数": {
            "核大小": {
              "类型": "int",
              "范围": [
                3,
                21,
                2
              ],
              "默认": 11
            },
            "强度": {
              "类型": "float",
              "范围": [
                0.1,
                2.0
              ],
              "默认": 1.0
            }
          }
        },
        "开运算": {
          "说明": "先腐蚀再膨胀，仅建议用于明显散点；半径过大会损伤细笔画",
          "参数": {
            "半径": {
              "类型": "int",
              "范围": [
                1,
                6
              ],
              "默认": 1
            },
            "迭代": {
              "类型": "int",
              "范围": [
                1,
                3
              ],
              "默认": 1
            },
            "核形状": {
              "类型": "int",
              "范围": [
                0,
                2
              ],
              "默认": 1
            }
          }
        },
        "闭运算": {
          "说明": "先膨胀再腐蚀，闭合小孔洞",
          "参数": {
            "半径": {
              "类型": "int",
              "范围": [
                1,
                6
              ],
              "默认": 1
            },
            "迭代": {
              "类型": "int",
              "范围": [
                1,
                3
              ],
              "默认": 1
            },
            "核形状": {
              "类型": "int",
              "范围": [
                0,
                2
              ],
              "默认": 1
            }
          }
        },
        "孔洞填充": {
          "说明": "仅填充受限小孔，保护汉字固有字腔",
          "参数": {
            "最大孔洞面积": {
              "类型": "int",
              "范围": [
                1,
                1000
              ],
              "默认": 80
            },
            "最大孔洞比例": {
              "类型": "float",
              "范围": [
                0.0,
                0.02
              ],
              "默认": 0.003
            }
          }
        },
        "形态学重建": {
          "说明": "从可信核心受限恢复原笔画，去点时比普通开运算更保形",
          "参数": {
            "半径": {
              "类型": "int",
              "范围": [
                1,
                3
              ],
              "默认": 1
            }
          }
        }
      }
    },
    "L5 连通域过滤": {
      "说明": "连通域分析，过滤孤立噪点簇",
      "算法": {
        "面积过滤": {
          "说明": "按连通域面积过滤小噪点",
          "参数": {
            "min_area": {
              "类型": "int",
              "范围": [
                10,
                500
              ],
              "默认": 60
            },
            "连通类型": {
              "类型": "int",
              "范围": [
                4,
                8,
                4
              ],
              "默认": 8
            },
            "相对模式": {
              "类型": "bool",
              "默认": false
            },
            "相对比例": {
              "类型": "float",
              "范围": [
                0.0001,
                0.01
              ],
              "默认": 0.002
            }
          }
        },
        "面积+形状过滤": {
          "说明": "面积+形状特征（长宽比/凸包比/实体比）过滤噪点",
          "参数": {
            "min_area": {
              "类型": "int",
              "范围": [
                10,
                500
              ],
              "默认": 60
            },
            "连通类型": {
              "类型": "int",
              "范围": [
                4,
                8,
                4
              ],
              "默认": 8
            },
            "相对模式": {
              "类型": "bool",
              "默认": false
            },
            "相对比例": {
              "类型": "float",
              "范围": [
                0.0001,
                0.01
              ],
              "默认": 0.002
            },
            "仅孤立": {
              "类型": "bool",
              "默认": true
            },
            "最大长宽比": {
              "类型": "float",
              "范围": [
                1,
                5
              ],
              "默认": 3
            },
            "最小凸包比": {
              "类型": "float",
              "范围": [
                0.5,
                1
              ],
              "默认": 0.7
            },
            "最小实体比": {
              "类型": "float",
              "范围": [
                0.3,
                1
              ],
              "默认": 0.4
            }
          }
        },
        "边界污染过滤": {
          "说明": "删除贴边窄条、版框和扫描阴影，并保护主要文字连通域",
          "参数": {
            "最大宽度比例": {
              "类型": "float",
              "范围": [
                0.02,
                0.4
              ],
              "默认": 0.18
            },
            "最大高度比例": {
              "类型": "float",
              "范围": [
                0.02,
                0.4
              ],
              "默认": 0.18
            },
            "保护主体数": {
              "类型": "int",
              "范围": [
                1,
                20
              ],
              "默认": 8
            }
          }
        }
      }
    }
  }
}